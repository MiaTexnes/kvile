# Noroff API v2 base URL (no trailing slash)
VITE_API_BASE_URL=https://v2.api.noroff.dev

# Required for logged-in flows (profiles, bookings, manager venues): create ONE app key —
# POST /auth/create-api-key with Authorization: Bearer <token> → paste `data.key` here.
# No spaces around `=`. After editing .env, restart `npm run dev` so Vite picks this up.
# Docs + interactive tool: https://docs.noroff.dev/docs/v2/auth/api-key#api-key-tool
VITE_NOROFF_API_KEY=